+            return retained
+        return {'arm': arm, 'accepted': False, 'blockers': ['no OpenCode records']}
+    accounting = A.account_opencode(snapshot, root_session_ids=(retained or {}).get('accounting', {}).get('root_session_ids', []), max_local_dispatches=manifest['budget']['initial'] + manifest['budget']['repair'], client=(retained or {}).get('client', 'opencode-cli'), **opencode_expectations(manifest))
+    if retained is None:
+        return {'arm': arm, 'accepted': False, 'blockers': ['arm was never run'], 'accounting': accounting}
+    retained['accounting'] = accounting
+    retained.setdefault('reaccount_source', ['archived native records'])
+    digest_path = evidence / 'complete.patch'
