index 0000000..614b0a9
--- /dev/null
+++ b/benchmarks/accounting.py
@@ -0,0 +1,604 @@
+import hashlib
+import json
+import re
+from pathlib import Path
+PROTOCOL = 'portable-cross-mac-1'
+OPENCODE_TOKEN_FIELDS = ('input', 'output', 'reasoning')
+OPENCODE_CACHE_FIELDS = ('read', 'write')
+OPENCODE_REQUIRED_FIELDS = ('input', 'output')
+CODEX_USAGE_FIELDS = ('input_tokens', 'output_tokens', 'total_tokens')
+ERROR_FINISHES = ('error', 'cancelled', 'canceled', 'aborted', 'failed')
+VALID_IDLE_OUTCOMES = ('ready', 'succeeded')
+EXPECTED_REASONING_VARIANT = 'medium'
+CODEX_COMPLETION_MARKERS = {'task_started': 'active', 'task_complete': 'complete', 'turn_aborted': 'aborted'}
+CODEX_SPAWN_TOOL = 'spawn_agent'
+CODEX_REPAIR_TOOLS = ('send_input', 'followup_task')
+
+def _agent_from_assistants(messages):
+    for message in messages:
+        if message.get('type') != 'assistant':
+            continue
+        try:
+            data = json.loads(message.get('data') or '{}')
+        except ValueError:
+            continue
+        if data.get('agent'):
+            return str(data['agent'])
+    return None
+EDIT_TOOLS = {'edit', 'write', 'apply_patch', 'patch', 'multiedit', 'notebook_edit', 'str_replace_editor'}
+CODEX_EDIT_TOOLS = {'apply_patch', 'edit', 'write', 'patch', 'notebook_edit'}
+CODEX_TOOL_CALL_TYPES = {'function_call', 'local_shell_call', 'custom_tool_call', 'web_search_call', 'mcp_tool_call'}
+SECRET_FIELD_HINTS = ('apikey', 'api_key', 'token', 'password', 'secret', 'auth', 'credential', 'bearer', 'accesskey')
+SECRET_REF_HINTS = ('key', 'secret', 'token', 'password', 'credential', '.env')
+REF_PATTERN = re.compile('\\{(file|env):([^{}]+)\\}')
+
+class PreflightBlocker(Exception):
+    """A concrete blocker that must stop an arm before any model is launched."""
+
+def as_int(value):
+    try:
+        return int(value or 0)
+    except (TypeError, ValueError):
+        return 0
+
+def sha256_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as handle:
+        for chunk in iter(lambda : handle.read(1 << 20), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+_FENCE = re.compile('^\\s*(```|~~~)')
+_VERDICT = re.compile('^VERDICT:\\s*(PASS|FAIL|CHANGES_REQUIRED)\\b[ \\t]*(.*)$', re.I)
+_SHA = re.compile('^([0-9a-f]{64})$')
+
+def find_verdicts(text):
+    found = []
+    fenced = False
+    for raw in (text or '').splitlines():
+        if _FENCE.match(raw):
+            fenced = not fenced
+            continue
+        line = raw.strip()
+        bare = line.replace('*', '').strip()
+        stripped = bare.lstrip('># \t')
+        match = _VERDICT.match(stripped)
+        if not match:
+            continue
+        quoted = bare != stripped or bare[:1] in '"\'`' or bare[-1:] in '"\'`' or ('`' in line)
+        state = 'fenced' if fenced else 'quoted' if quoted else 'plain'
+        rest = match.group(2).strip().strip('`*"\' ')
+        first = rest.split()[0] if rest.split() else ''
+        sha_match = _SHA.match(first)
+        found.append({'verdict': match.group(1).upper(), 'state': state, 'sha': sha_match.group(1) if sha_match else first[:80], 'full_sha_present': bool(sha_match), 'line': line[:400]})
+    return found
+
+def semantic_verdict(text, expected_sha):
+    candidates = find_verdicts(text)
+    plain = [c for c in candidates if c['state'] == 'plain']
+    rejected = [c for c in candidates if c['state'] != 'plain']
+    if not plain:
+        return {'status': 'forged' if rejected else 'absent', 'digest_matches': False, 'candidate': None, 'rejected_non_plain': rejected}
+    last = plain[-1]
+    if not last['full_sha_present']:
+        return {'status': 'missing_digest', 'digest_matches': False, 'candidate': last, 'rejected_non_plain': rejected}
+    return {'status': 'pass' if last['verdict'] == 'PASS' else 'not_pass', 'digest_matches': last['sha'] == expected_sha, 'candidate': last, 'rejected_non_plain': rejected}
+
+def _secret_field(name):
+    low = re.sub('[^a-z0-9]', '', str(name).lower())
+    return any((h in low for h in SECRET_FIELD_HINTS))
+
+def _secret_ref(target):
+    base = Path(str(target)).name.lower()
+    return any((h in base for h in SECRET_REF_HINTS))
+
+def _resolve_ref(value, config_dir, env):
+    def one(match):
+        (kind, target) = (match.group(1), match.group(2))
+        if _secret_ref(target):
+            return '<redacted-unresolved-credential-ref>'
+        if kind == 'env':
+            raw = env.get(target)
+            return raw.strip()[:200] if raw is not None else f'<unset-env:{target}>'
+        try:
+            text = (config_dir / target).resolve().read_text(encoding='utf-8').strip()
+        except OSError:
+            return f'<missing-file:{target}>'
+        return text[:200]
+    return REF_PATTERN.sub(one, value)
+
+def _redact(node, config_dir, env, stats):
+    if isinstance(node, dict):
+        out = {}
+        for (key, value) in node.items():
+            if _secret_field(key):
+                stats['redacted_fields'] += 1
+                continue
+            resolved_key = _resolve_ref(key, config_dir, env) if isinstance(key, str) else key
+            if _secret_field(resolved_key):
+                stats['redacted_fields'] += 1
+                continue
+            if resolved_key != key:
+                stats['resolved_keys'] += 1
+            out[resolved_key] = _redact(value, config_dir, env, stats)
+        return out
+    if isinstance(node, list):
+        return [_redact(item, config_dir, env, stats) for item in node]
+    if isinstance(node, str):
+        resolved = _resolve_ref(node, config_dir, env)
+        if resolved != node:
+            stats['resolved_refs'] += 1
+        return resolved
+    return node
+
+def config_snapshot(config_path, env=None):
+    env = dict(env if env is not None else {})
+    path = Path(config_path)
+    if not path.exists():
+        raise PreflightBlocker(f'native config missing: {path}')
+    raw = path.read_text(encoding='utf-8')
+    try:
+        config = json.loads(raw)
+    except ValueError as exc:
+        raise PreflightBlocker(f'native config {path} is not strict JSON (JSONC unsupported): {exc}') from exc
+    stats = {'redacted_fields': 0, 'resolved_refs': 0, 'resolved_keys': 0}
+    snapshot = _redact(config, path.resolve().parent, env, stats)
+    return {'path': str(path), 'snapshot': snapshot, 'stats': stats, 'raw_sha256': sha256_bytes(raw.encode('utf-8'))}
+
+def validate_native_profile(snapshot, local_model):
+    root = snapshot.get('snapshot') or {}
+    agents = root.get('agents') or {}
+    blockers = []
+    hybrid = agents.get('hybrid')
+    review = agents.get('review') or {}
+    general = agents.get('general') or {}
+    if not isinstance(hybrid, dict):
+        blockers.append('installed native config has no hybrid agent')
+    for (name, agent) in (('hybrid', hybrid), ('review', review)):
+        if isinstance(agent, dict) and agent.get('model'):
+            blockers.append(f"agent {name} pins model {agent['model']!r}; Hybrid and review must inherit the caller cloud model")
+    observed = {'general_model': general.get('model'), 'hybrid_has_model': bool(isinstance(hybrid, dict) and hybrid.get('model')), 'review_has_model': bool(isinstance(review, dict) and review.get('model')), 'default_agent': root.get('default_agent'), 'subagent_depth': (root.get('experimental') or {}).get('subagent_depth')}
+    if observed['general_model'] != local_model:
+        blockers.append(f"installed general worker model {observed['general_model']!r} does not match --local-model {local_model!r}")
+    return (blockers, observed)
+
+def _assistant_text(payload):
+    kind = payload.get('type')
+    if kind == 'agent_message':
+        return str(payload.get('message') or '')
+    if kind == 'message' and payload.get('role') == 'assistant':
+        parts = payload.get('content') or []
+        texts = [p.get('text', '') for p in parts if isinstance(p, dict) and p.get('type') in ('output_text', 'text')]
+        return '\n'.join((t for t in texts if t))
+    return None
+
+def _spawned_id(output):
+    node = output if isinstance(output, dict) else None
+    if node is None:
+        try:
+            node = json.loads(str(output or ''))
+        except ValueError:
+            return None
+    if not isinstance(node, dict):
+        return None
+    for key in ('thread_id', 'agent_id'):
+        value = node.get(key)
+        if isinstance(value, str) and value:
+            return value
+    return None
+
+def scan_codex_rollout(path):
+    record = {'path': str(path), 'session_id': None, 'cwd': None, 'parent_id': None, 'models': [], 'efforts': [], 'usage': None, 'usage_updates': 0, 'tool_calls': 0, 'edit_calls': 0, 'assistant_texts': [], 'first_event': None, 'last_event': None, 'malformed_lines': 0, 'completion': 'unknown', 'completion_markers': [], 'spawn_calls': 0, 'repair_calls': 0, 'spawned_ids': []}
+    try:
+        handle = Path(path).open('r', encoding='utf-8', errors='replace')
+    except OSError:
+        return None
+    with handle:
