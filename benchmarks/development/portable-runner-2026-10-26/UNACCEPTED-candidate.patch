+        messages_table = _table(conn, ('session_message', 'session_message_v2'))
+        directories = [str(d) for d in repo_dirs]
+        found = {}
+        if directories:
+            placeholders = ','.join('?' * len(directories))
+            for row in conn.execute(f'select * from {sessions_table} where directory in ({placeholders}) order by time_created', directories):
